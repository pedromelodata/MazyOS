# Copie este arquivo para .env e preencha. O .env NÃO vai pro git.
# Nada daqui chega no navegador: o servidor guarda e usa só do lado dele.

# ---------------- Instagram ----------------
# Caminho recomendado: NÃO precisa preencher nada aqui. Abra Instagram > Métricas no app
# e cole o token do usuário do sistema do Gerenciador de Negócios. Ele fica em
# data/instagram.json (também fora do git).

# versão da Graph API (v26.0 era a mais nova em 22/09/2026)
IG_GRAPH_VERSION=v26.0

# Opcional: botão "Entrar com Facebook" (OAuth). Precisa de um app em developers.facebook.com
# com o produto Login do Facebook e esta URL de redirecionamento válida:
#   http://localhost:4317/api/instagram/callback   (troque 4317 se mudar a PORT)
# Com o link público (PUBLIC_URL, abaixo), a URL a cadastrar é <PUBLIC_URL>/api/instagram/callback
META_APP_ID=
META_APP_SECRET=
# opcional: id da configuração do Login do Facebook para Empresas (vai no lugar das permissões)
META_LOGIN_CONFIG_ID=

# Compatível com a versão 1: token e id da conta direto aqui. Só vale se ninguém conectou pelo app.
# Token com instagram_basic, instagram_manage_insights, pages_show_list, pages_read_engagement,
# business_management e ads_read (ads_read: exigido quando a Página vem pelo Gerenciador de Negócios)
IG_ACCESS_TOKEN=
# id do instagram_business_account (Graph API Explorer: me/accounts?fields=instagram_business_account)
IG_USER_ID=

# ---------------- App ----------------
# opcional: modelo do chat "Criar reel" e do "Gerar ideias" (vazio = o padrão do seu Claude Code)
CRONOGRAMA_MODEL=

# opcional: porta do servidor local
PORT=4317

# ---------------- Link público (Cloudflare Tunnel) ----------------
# O servidor continua escutando só em 127.0.0.1; o cloudflared leva o link público até ele.
# Todo acesso exige login (usuário e senha). Conta nova e senha esquecida só por link único, gerado em
# Usuários (menu da conta) ou no terminal: npm run usuario convite [nome] | redefinir <login>
# deploy\tunel-permanente.ps1 preenche as duas linhas abaixo sozinho (padrão: mkt.legalizai.com.br).

# endereços públicos aceitos, separados por vírgula (só o host, sem https://)
# Os de túnel rápido (*.trycloudflare.com, deploy\tunel-rapido.ps1) já são aceitos sem estar aqui.
PUBLIC_HOSTS=
# endereço público completo, sem barra no fim. É o começo dos links de acesso e de senha nova (vazio =
# http://localhost:PORT, que só abre neste computador) e o retorno do "Entrar com Facebook"
PUBLIC_URL=
