{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:legalizai:kit-motion:esquema:biblioteca2d",
  "title": "Catálogo da biblioteca 2D da precificação",
  "description": "Componentes 2D (K14; seção 4.9).",
  "type": "object",
  "required": [
    "versao",
    "camada",
    "tipo",
    "itens"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "camada": {
      "enum": [
        "base",
        "aquisicoes"
      ]
    },
    "tipo": {
      "const": "biblioteca2d"
    },
    "geradoEm": {
      "type": "string"
    },
    "geradoPor": {
      "type": "string"
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "itens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "liberado",
        "aceito-com-risco",
        "sem-verificacao",
        "reprovado"
      ],
      "description": "liberado | aceito-com-risco | sem-verificacao | reprovado"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "arquivo",
        "exportacao",
        "acoplamento",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^p2d-[A-Za-z0-9_-]+$"
        },
        "arquivo": {
          "type": "string",
          "minLength": 1
        },
        "exportacao": {
          "type": "string",
          "minLength": 1
        },
        "linhas": {
          "type": [
            "string",
            "array",
            "null"
          ]
        },
        "assinatura": {
          "type": [
            "string",
            "object",
            "null"
          ]
        },
        "desenha": {
          "type": [
            "string",
            "null"
          ]
        },
        "canais": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publicNecessario": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acoplamento": {
          "enum": [
            "puro",
            "timeline-0210",
            "interno-nao-exportado"
          ]
        },
        "camada": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "cuidados": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "usos": {
          "type": "array"
        },
        "notas": {
          "type": "string"
        },
        "decisaoRisco": {
          "$ref": "#/$defs/decisaoRisco"
        }
      }
    },
    "sobreposicao": {
      "description": "camada de sobreposição (verificacoes.json, revisao-*.json, provas.json): só troca campos de itens que já existem; 'verificacao' e 'usos' são concatenadas",
      "type": "object",
      "required": [
        "versao",
        "camada",
        "itens"
      ],
      "properties": {
        "versao": {
          "const": 1
        },
        "camada": {
          "type": "string",
          "minLength": 1
        },
        "itens": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "decisaoRisco": {
      "description": "decisão de risco do status aceito-com-risco (catalogos/LEIA-ME.md, seção Status): quem decidiu, quando (AAAA-MM-DD), em que peças vale ('*' = qualquer peça), o que foi decidido e onde está registrado; com o Pedro ainda sem decidir: pendente true, quando null e a pergunta. Texto livre é o formato antigo: o valida.py recusa em item aceito-com-risco do catálogo mesclado.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "quem",
            "pecas",
            "texto"
          ],
          "additionalProperties": false,
          "properties": {
            "quem": {
              "type": "string",
              "minLength": 1
            },
            "quando": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "pecas": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "texto": {
              "type": "string",
              "minLength": 1
            },
            "fonte": {
              "type": "string"
            },
            "pendente": {
              "type": "boolean"
            },
            "pergunta": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
