{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:legalizai:kit-motion:esquema:referencia",
  "title": "Registro congelado da referência (REF)",
  "description": "Formato do _referencia.json (seção 4.13).",
  "type": "object",
  "required": [
    "versao",
    "camada",
    "peca",
    "registradoEm",
    "registradoPor",
    "motivo",
    "regras",
    "esperado",
    "totalCopiasBytes",
    "arquivos"
  ],
  "properties": {
    "versao": {
      "const": 1
    },
    "camada": {
      "const": "referencia-regressao"
    },
    "peca": {
      "type": "string",
      "minLength": 1
    },
    "registradoEm": {
      "type": "string",
      "minLength": 1
    },
    "registradoPor": {
      "type": "string",
      "minLength": 1
    },
    "motivo": {
      "type": "string",
      "minLength": 1
    },
    "regras": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "esperado": {
      "type": "object",
      "required": [
        "fluxoVideoMd5",
        "videoIgualAoMudo",
        "audioV4ContraMixGuia",
        "juncao",
        "perfilEfeitos",
        "telas",
        "historico"
      ],
      "properties": {
        "fluxoVideoMd5": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "videoIgualAoMudo": {
          "type": "boolean"
        },
        "audioV4ContraMixGuia": {
          "type": "object",
          "required": [
            "atrasoAmostras",
            "correlacao",
            "diferencaNivelDb"
          ],
          "properties": {
            "atrasoAmostras": {
              "type": "integer"
            },
            "correlacao": {
              "type": "number"
            },
            "diferencaNivelDb": {
              "type": "number"
            }
          }
        },
        "juncao": {
          "type": "string",
          "minLength": 1
        },
        "perfilEfeitos": {
          "type": "string",
          "minLength": 1
        },
        "telas": {
          "type": "string",
          "minLength": 1
        },
        "historico": {
          "type": "object"
        }
      }
    },
    "totalCopiasBytes": {
      "type": "integer"
    },
    "arquivos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "caminho",
          "tamanho",
          "md5",
          "st_ino",
          "st_nlink",
          "mtime",
          "copia"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "caminho": {
            "type": "string",
            "minLength": 1
          },
          "tamanho": {
            "type": "integer"
          },
          "md5": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "st_ino": {
            "type": "integer"
          },
          "st_nlink": {
            "type": "integer"
          },
          "mtime": {
            "type": "string",
            "minLength": 1
          },
          "fluxoVideoMd5": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "fluxoAudioMd5": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "loudness": {
            "type": "object"
          },
          "sonda": {
            "type": "object"
          },
          "imagem": {
            "type": "object"
          },
          "conteudo": {
            "type": "object"
          },
          "copia": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
